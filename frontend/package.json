{
	"name": "sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test:dialog": "node scripts/dialog-e2e.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:reorder": "node scripts/agent-reorder-e2e.mjs",
		"test:home-drag": "node scripts/home-drag-e2e.mjs",
		"test:unmanaged": "node scripts/unmanaged-e2e.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"pocketbase": "^0.25.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "5.33.19",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.45.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"marked": "^18.0.12",
		"svelte-dnd-action": "^0.9.79",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
